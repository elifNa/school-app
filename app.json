{
  "expo": {
    "name": "Study Support",
    "slug": "school-academic-support",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": { "bundler": "metro", "output": "single" },
    "ios": { "supportsTablet": true, "bundleIdentifier": "edu.school.support" },
    "android": { "package": "edu.school.support", "adaptiveIcon": { "backgroundColor": "#f5f6f8" } },
    "plugins": [
      ["expo-image-picker", {
        "photosPermission": "Allow Study Support to attach a photo to a question or reply.",
        "cameraPermission": "Allow Study Support to take a question or solution photo.",
        "microphonePermission": false
      }],
      "expo-secure-store",
      ["expo-splash-screen", { "backgroundColor": "#f5f6f8" }]
    ]
  }
}
